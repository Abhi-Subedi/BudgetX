# BudgetX Frontend Environment
# Copy to `.env.local` and adjust. Never commit your real `.env.local`.

# Backend API URL (local: http://localhost:8000/api, production: https://budget-x-drab.vercel.app/api)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# OAuth Redirect Base (local: http://localhost:3000, production: https://budget-x-ch9q.vercel.app)
NEXT_PUBLIC_OAUTH_REDIRECT_BASE=http://localhost:3000
